[Unit]
Description=COPSSTEC FastAPI backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=copsstec
Group=copsstec
WorkingDirectory=/var/www/copsstec-system/backend
EnvironmentFile=/var/www/copsstec-system/backend/.env
ExecStart=/var/www/copsstec-system/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8081 --workers 2
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
