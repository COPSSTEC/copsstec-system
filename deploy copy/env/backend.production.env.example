# Copiar a /var/www/copsstec-system/backend/.env
# El backend escucha SOLO en 127.0.0.1:8081 (Nginx hace de proxy).

DATABASE_URL=postgresql://copsstec:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/copsstec
SECRET_KEY=genera-una-clave-larga-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480
PASSWORD_RESET_EXPIRE_MINUTES=60
APP_ENV=production

# Debe coincidir EXACTAMENTE con la URL pública (sin slash final).
FRONTEND_ORIGIN=https://TU_DOMINIO.com

MEMBERSHIP_FEE=10.00
MEMBERSHIP_BANK_NAME=Banco Pichincha
MEMBERSHIP_ACCOUNT_TYPE=Cuenta de ahorros
MEMBERSHIP_ACCOUNT_NUMBER=XXXXXXXXXX
MEMBERSHIP_ACCOUNT_HOLDER=COPSSTEC
MEMBERSHIP_ACCOUNT_RUC=

MAILBOX_API_URL=https://box.copsstec.com
MAILBOX_ADMIN_EMAIL=administrator@copsstec.com
MAILBOX_ADMIN_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=COPSSTEC <no-reply@copsstec.com>
SMTP_USE_TLS=true
MAIL_LOGO_URL=https://www.copsstec.com/assets/logos/coppstec.png
MAIL_SUPPORT_EMAIL=soporte@copsstec.com
MAIL_ADMIN_NOTIFICATIONS=administrator@copsstec.com
MAILBOX_WEB_URL=https://box.copsstec.com/mail/
CORPORATE_EMAIL_DOMAIN=copsstec.com
